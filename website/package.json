{
  "name": "ratools-for-pdf-manual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "node --import ./scripts/recycle-guard.mjs scripts/run-astro.mjs dev",
    "build": "node --import ./scripts/recycle-guard.mjs scripts/run-astro.mjs build",
    "build:portal": "node scripts/build-portal.mjs",
    "preview": "node --import ./scripts/recycle-guard.mjs scripts/run-astro.mjs preview",
    "check": "node --import ./scripts/recycle-guard.mjs scripts/run-astro.mjs check",
    "check:site": "node scripts/check-site.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.10",
    "astro": "7.4.10",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "typescript": "5.9.3"
  }
}
